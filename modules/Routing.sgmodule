# Source 14: rules/WhatsApp-Companion-WIDE.list
# Policy: PROXY
# WhatsApp with wider fallback for calls, but without fully swallowing all Meta traffic

# --- App hints ---
PROCESS-NAME,WhatsApp,PROXY
USER-AGENT,WhatsApp*,PROXY

# --- Core WhatsApp domains ---
DOMAIN-SUFFIX,whatsapp.com,PROXY
DOMAIN-SUFFIX,whatsapp.net,PROXY
DOMAIN-SUFFIX,wa.me,PROXY
DOMAIN-SUFFIX,g.whatsapp.net,PROXY
DOMAIN-SUFFIX,v.whatsapp.net,PROXY
DOMAIN-SUFFIX,mmg.whatsapp.net,PROXY
DOMAIN-SUFFIX,media.whatsapp.net,PROXY
DOMAIN-SUFFIX,static.whatsapp.net,PROXY
DOMAIN-SUFFIX,cdn.whatsapp.net,PROXY
DOMAIN-SUFFIX,pps.whatsapp.net,PROXY

# --- Calls/media preference over UDP ---
AND,((DOMAIN-SUFFIX,v.whatsapp.net),(PROTOCOL,UDP)),PROXY
AND,((DOMAIN-SUFFIX,mmg.whatsapp.net),(PROTOCOL,UDP)),PROXY
AND,((DOMAIN-SUFFIX,media.whatsapp.net),(PROTOCOL,UDP)),PROXY

# --- IPv6 Meta fallback for calls ---
AND,((IP-CIDR6,2a03:2880::/12,no-resolve),(PROTOCOL,UDP)),PROXY

# --- Wider IPv4 fallback, but not full Meta swallow ---
