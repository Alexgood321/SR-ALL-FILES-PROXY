#!name=Ads + Privacy Block
#!desc=Опциональная блокировка рекламы/трекеров. Использовать отдельным модулем ВЫШЕ Unified Routing + System DNS.
#!author=OpenAI + user
#!version=1.0

# =============================================================================
# НАЗНАЧЕНИЕ
# =============================================================================
# Этот модуль содержит только REJECT-правила рекламы, рекламных SDK, аналитики
# и privacy/tracker endpoints. Он НЕ содержит DIRECT/PROXY/System DNS и не является
# обязательным для работы VPN.
#
# Рекомендуемое расположение в Shadowrocket:
#   Ads + Privacy Block            <- выше
#   Unified Routing + System DNS   <- ниже
#
# Причина: Shadowrocket применяет first-match и верхний модуль имеет более высокий
# приоритет. Поэтому точечные REJECT здесь должны срабатывать раньше широких
# PROXY/DIRECT правил Unified.
#
# Если после обновления приложение перестало запускаться, зависает или не загружает
# контент, этот модуль можно временно отключить целиком для быстрой диагностики.
#
# =============================================================================
# РИСК / ДИАГНОСТИКА
# =============================================================================
# LOW/MEDIUM: конкретные рекламные и tracker endpoints обычно затрагивают только
# соответствующие SDK/сервисы, но плохо написанное приложение может ожидать ответ
# рекламного SDK и зависать при его блокировке.
#
# AGGRESSIVE: правила DOMAIN-KEYWORD,ads и DOMAIN-SUFFIX,unity3d.com имеют широкую
# область действия. Они перенесены из production Unified без изменения поведения,
# но при любой новой регрессии должны проверяться первыми.
#
# ВАЖНО: DOMAIN-KEYWORD,ads может совпасть с любым hostname, содержащим "ads".
# Уже известное пересечение: iadsdk.apple.com. Поэтому это правило повышенного риска.
#
# =============================================================================
# ЖУРНАЛ АКТУАЛИЗАЦИИ
# =============================================================================
# 2026-09-04 — версия 1.0.
# Создан отдельный Ads + Privacy Block. Из Unified перенесены все 28 активных
# рекламных/privacy REJECT-правил без изменения их policy и без потери правил.
# Цель: отделить необязательный ad/privacy слой от обязательной routing/DNS базы.
# Источники блоков: прежний VK/Mail privacy block и пользовательский UHF IPTV
# Ads Block (Unity Ads/Mediation, AppLovin, Mintegral/Rayjump, Pangle, Vungle,
# Meta analytics). DOMAIN-KEYWORD,ads и широкий unity3d.com оставлены активными
# только для сохранения текущего production-поведения и отмечены как AGGRESSIVE.
#
# Любое будущее изменение [Rule] фиксировать здесь: дата, блок/сервис, что изменено,
# причина, возможная зона влияния и основание (PacketTunnel/runtime/source).
#
[Rule]

# ==================================================
# 01) VK / MAIL / MYTARGET PRIVACY
# ==================================================

# --- REJECT-ARRAY ---
DOMAIN,alt-ad.mail.ru,REJECT-ARRAY
DOMAIN,ad.mail.ru,REJECT-ARRAY

# --- REJECT-TINYGIF ---
DOMAIN-SUFFIX,mradx.net,REJECT-TINYGIF

# --- REJECT-DICT ---
DOMAIN-SUFFIX,target.my.com,REJECT-DICT
DOMAIN-SUFFIX,advertising.my.com,REJECT-DICT
DOMAIN-SUFFIX,mytarget.com,REJECT-DICT

# --- REJECT ---
DOMAIN-SUFFIX,tracker-api.vk-analytics.ru,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,tracker-api.my.com,REJECT

# --- REJECT-200 ---
DOMAIN-SUFFIX,top.mail.ru,REJECT-200
DOMAIN,r.mail.ru,REJECT-200

# ==================================================
# 02) UHF IPTV / UNITY ADS
# ==================================================
# Более специфичные endpoints стоят выше широких suffix для сохранения first-match.
DOMAIN-SUFFIX,mediation.unity3d.com,REJECT-DICT
DOMAIN-SUFFIX,config.unityads.unity3d.com,REJECT-DICT
DOMAIN,cdn.iads.unity3d.com,REJECT-VIDEO
DOMAIN-SUFFIX,iads.unity3d.com,REJECT-DICT
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT-VIDEO
DOMAIN-SUFFIX,isx.unity3d.com,REJECT-200

# AGGRESSIVE: весь unity3d.com, а не только рекламные endpoints.
DOMAIN-SUFFIX,unity3d.com,REJECT-200

# ==================================================
# 03) APPLOVIN
# ==================================================
DOMAIN-SUFFIX,applovin.com,REJECT-DICT
DOMAIN-SUFFIX,applvn.com,REJECT-DICT

# ==================================================
# 04) MINTEGRAL / RAYJUMP
# ==================================================
DOMAIN-SUFFIX,mintegral.com,REJECT-DICT
DOMAIN-SUFFIX,rayjump.com,REJECT-DICT

# ==================================================
# 05) PANGLE
# ==================================================
DOMAIN-SUFFIX,tiktokpangle.us,REJECT-DICT
DOMAIN-SUFFIX,tiktokpangle-b.us,REJECT-DICT
DOMAIN-SUFFIX,tiktokpangle-cdn-us.com,REJECT-VIDEO

# ==================================================
# 06) VUNGLE
# ==================================================
DOMAIN-SUFFIX,vungle.com,REJECT-DICT

# ==================================================
# 07) GLOBAL / ATTRIBUTION / ANALYTICS
# ==================================================

# AGGRESSIVE: глобально ловит любой hostname с подстрокой "ads".
DOMAIN-KEYWORD,ads,REJECT-TINYGIF

DOMAIN,ep2.facebook.com,REJECT-200
