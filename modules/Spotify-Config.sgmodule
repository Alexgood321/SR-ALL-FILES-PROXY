#!name=Spotify Premium (Alexgood321) FIX + Ad Patch [TEMP UCS DIAG]
#!desc=Временный диагностический цикл UCS/MFT. Premium protobuf patch отключён только на время теста.

# last_update=2026-09-27_UTC
# Authors / credits:
#   app2smile — оригинальные Spotify scripts и protobuf-логика
#   daozen — предыдущий playback/trials protobuf experiment (сейчас не активен)
#   Amlabort / MY_clash — предыдущий EV3 protobuf experiment (сейчас не активен)
#   LOWERTOP / Shadowrocket-First — Shadowrocket reference
#   Alexgood321 / SR-ALL-FILES-PROXY — локальное зеркало и интеграция
#
# Source: app2smile/rules @ e2c6f341eff294ce863658b95a490143183314b9
# Upstream Spotify scripts are exact copies pinned in this repository.
# Repository-specific patches are explicitly marked as LOCAL PATCH below.
# License: MIT, modules/spotify/LICENSE.md

[Header Rewrite]
# Не даём customize вернуться как 304 без body.
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
# LOCAL PATCH — TEMP UCS/MFT diagnostic cycle (2026-09-27).
# На время одного диагностического прогона активный spotify-proto response patch
# отключён, чтобы увидеть СЫРЫЕ server-provided UCS assignedValues до Premium spoof.
# После получения лога этот блок нужно вернуть к обычному spotify-proto.
#
# В Shadowrocket для одного request фактически срабатывает одно matching script rule,
# поэтому узкие Connect diagnostics стоят ВЫШЕ общего spotify-timezone и сами
# повторяют только timezone-подмену Europe/Moscow -> Europe/Helsinki.

# LOCAL PATCH — player command request diagnostic.
# Главная точка диагностики: логирует реальный endpoint команды (seek_to/skip_next/play),
# position/relative/context/track и from/to device. Тело команды НЕ меняет.
spotify-connect-command-diagnostic = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/connect-state\/v1\/player\/command\/,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/8e410d9af06ad03f62bf34524c44fd8183ccb176/modules/spotify/spotify-connect-command-diagnostic.js,script-update-interval=0

# LOCAL PATCH — player command response diagnostic.
# Логирует HTTP status для той же команды. Ответ Spotify не меняет.
spotify-connect-command-response = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/connect-state\/v1\/player\/command\/,requires-body=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/4cc2edf032bccf7839413677b66874778b68849d/modules/spotify/spotify-connect-command-response-diagnostic.js,script-update-interval=0

# LOCAL PATCH — Connect-State PlayerState diagnostic v2.
# Логирует текущий context/track/position/duration и ограничения seek/skip из
# PUT /connect-state/v1/devices/*. Protobuf body НЕ меняется.
spotify-connect-state-diagnostic = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/connect-state\/v1\/devices\/,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/61673d731113dcbc95512af99b3f05c5e778fd97/modules/spotify/spotify-connect-state-diagnostic-v2.js,script-update-interval=0

# LOCAL PATCH — Spotify timezone alignment.
# Общий fallback для остальных Spotify requests. Специфичные Connect rules выше
# уже выполняют эту же узкую подмену, потому до этого правила они не доходят.
# Подменяет только Europe/Moscow -> Europe/Helsinki в Time-Zone/X-Client-Timezone
# и параметрах timezone/client-timezone. Остальные данные запроса не меняет.
spotify-timezone = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/,requires-body=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/81f6d1e8f55072c19e00232ab4fed51a2b402b02/modules/spotify/spotify-timezone.js,script-update-interval=0

# Artist View / Album Entity View.
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/9cb840aaf982a8871fdc231342e9191f30d35a45/modules/spotify/spotify-json.js

# LOCAL PATCH — READ-ONLY UCS assignedValues diagnostic.
# Логирует только интересующие MFT/free-on-demand/capping/pick-and-shuffle/
# playback-timeout параметры из bootstrap/customize. Ответ Spotify НЕ изменяет.
spotify-ucs-assigned-diagnostic = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/b57861c98b55b87306a5e1bc29facdbb7def9220/modules/spotify/spotify-ucs-assigned-diagnostic.js,script-update-interval=0
