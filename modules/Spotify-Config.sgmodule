# last_update=2026-09-26_UTC
#!name=Spotify – SR ALL
#!category=Spotify
#!desc=Spotify для Shadowrocket: локальная обработка Spotify protobuf, блокировка рекламных endpoint, отключение QUIC для MITM и опциональный перевод текстов. Идеи и исходные подходы: LOWERTOP/Shadowrocket-First, 001ProMax/Surge, app2smile/rules. Локальная реализация и интеграция: Alexgood321 / SR-ALL-FILES-PROXY.
#!arguments=Перевод_текста:false,AppID_Baidu:не_задан,Ключ_Baidu:не_задан,Компактная_панель:true
#!arguments-desc=Параметры модуля\n\n• Перевод_текста — включает перевод текста песни через Baidu Translate API. По умолчанию выключен.\n\n• AppID_Baidu и Ключ_Baidu — нужны только для перевода текста.\n\n• Компактная_панель — скрывает поддерживаемый Spotify пункт Your Plan в боковом интерфейсе.\n\nВсе исполняемые JS-файлы загружаются только из Alexgood321/SR-ALL-FILES-PROXY.
#!author=LOWERTOP, 001ProMax, app2smile; локальная реализация: Alexgood321
#!homepage=https://github.com/Alexgood321/SR-ALL-FILES-PROXY

# =============================================================================
# НАЗНАЧЕНИЕ И МОДЕЛЬ ДОВЕРИЯ
# =============================================================================
#
# Модуль автономен относительно сторонних репозиториев:
#   • основной JS находится в modules/spotify.response.js этого репозитория;
#   • перевод текстов находится в modules/spotify.lyrics.js этого репозитория;
#   • сторонние raw.githubusercontent.com script-path отсутствуют;
#   • внешняя иконка удалена.
#
# Имена LOWERTOP, 001ProMax и app2smile сохранены как attribution источникам
# исходных подходов. Их репозитории НЕ загружаются Shadowrocket при работе модуля.
#
# Единственный намеренный внешний сервис помимо Spotify:
#   Baidu Translate API — только когда Перевод_текста=true.
#   При выключенном переводе запросов к Baidu нет.
#
# Что делает модуль:
#   1. Блокирует QUIC для spotify.com, чтобы нужные запросы шли через TCP/TLS
#      и могли быть обработаны MITM/Script в Shadowrocket.
#   2. Для Artist View меняет platform=iphone на platform=ipad.
#   3. Локально отвечает HTTP 200 на рекламные endpoint ad-* и pendragon.
#   4. Обрабатывает bootstrap и user-customization-service локальным JS.
#   5. Опционально переводит lyrics через Baidu Translate локальным JS.
#
# Ограничения:
#   • это не серверная подписка Spotify Premium;
#   • серверные функции Spotify могут оставаться недоступными;
#   • максимальное качество Very High не гарантируется;
#   • совместимость зависит от текущей версии Spotify и структуры его API.
#
# MITM ограничен Spotify API-хостами ниже. Сертификат Shadowrocket должен быть
# установлен и считаться доверенным в iOS.


# =============================================================================
# RULE: ЗАПРЕТ QUIC ДЛЯ SPOTIFY
# =============================================================================
#
# QUIC/HTTP3 работает поверх UDP и может обходить HTTPS-путь, который нужен
# Shadowrocket для Rewrite/Script/MITM. REJECT-NO-DROP заставляет Spotify
# перейти на TCP/TLS для доменов spotify.com.

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT-NO-DROP


# =============================================================================
# URL REWRITE: ARTIST VIEW
# =============================================================================
#
# Подход используется в сборках 001ProMax/LOWERTOP.
# Для Artist View platform=iphone заменяется на platform=ipad.

[URL Rewrite]
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad header


# =============================================================================
# MAP LOCAL: РЕКЛАМНЫЕ ENDPOINT
# =============================================================================
#
# Для endpoint ad-* и pendragon Shadowrocket возвращает локальный пустой
# HTTP 200 вместо передачи запроса дальше.

[Map Local]
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:ad-|pendragon) data-type=text data="" status-code=200


# =============================================================================
# SCRIPT: ЛОКАЛЬНАЯ ОБРАБОТКА SPOTIFY
# =============================================================================
#
# Файл находится в этом же репозитории:
#   modules/spotify.response.js
#
# Скрипт не выполняет внешних HTTP-запросов. Он локально разбирает бинарный
# protobuf-ответ Spotify, изменяет клиентские account attributes и собирает
# protobuf обратно. Неизвестные protobuf-поля сохраняются.
#
# Компактная_панель передаётся как argument=tab=... .

[Script]
Spotify.Response = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/main/modules/spotify.response.js,requires-body=true,binary-body-mode=true,max-size=0,argument=tab={{{Компактная_панель}}}

# -----------------------------------------------------------------------------
# SCRIPT: ОПЦИОНАЛЬНЫЙ ПЕРЕВОД ТЕКСТОВ
# -----------------------------------------------------------------------------
#
# Файл находится в этом же репозитории:
#   modules/spotify.lyrics.js
#
# По умолчанию выключен. При включении текст песни отправляется в официальный
# Baidu Translate API. AppID передаётся API; Ключ_Baidu используется локально
# для MD5-подписи и напрямую в тело запроса не помещается.

Spotify.Lyrics = type=http-response,pattern=^https:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/,requires-body=true,binary-body-mode=true,max-size=0,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/main/modules/spotify.lyrics.js,enable={{{Перевод_текста}}},argument=appid={{{AppID_Baidu}}}&securityKey={{{Ключ_Baidu}}}


# =============================================================================
# MITM
# =============================================================================
#
# %APPEND% добавляет только нужные Spotify API-хосты к существующему MITM.
# Другие домены устройства этим модулем не добавляются в MITM.

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com
