#!name=Spotify Premium (Alexgood321) FIX + Ad Patch
#!desc=Без рекламы + on-demand + отключение shuffle. Частичная клиентская разблокировка Premium.
#!arguments=Компактная_панель:true

# last_update=2026-09-26_UTC
# Authors / upstream: LOWERTOP, 001ProMax, app2smile
# Local implementation and integration: Alexgood321 / SR-ALL-FILES-PROXY

# =============================================================================
# НАЗНАЧЕНИЕ И МОДЕЛЬ ДОВЕРИЯ
# =============================================================================
#
# Модуль автономен относительно сторонних репозиториев:
#   • основной JS находится в modules/spotify.response.js этого репозитория;
#   • сторонние raw.githubusercontent.com script-path отсутствуют;
#   • внешняя иконка отсутствует;
#   • script-path закреплён на конкретный commit SHA, поэтому изменение main
#     в будущем само по себе не изменит выполняемый Shadowrocket код.
#
# Attribution:
#   • LOWERTOP / Shadowrocket-First — компоновка Shadowrocket-подхода;
#   • 001ProMax / Surge — основная Spotify protobuf-логика и правила;
#   • app2smile / rules — приём удаления If-None-Match для предотвращения 304;
#   • Alexgood321 / SR-ALL-FILES-PROXY — локальная реализация и документация.
#
# Никакие репозитории LOWERTOP, 001ProMax или app2smile Shadowrocket при работе
# этого модуля не загружает.
#
# Что делает модуль:
#   1. Удаляет If-None-Match у user-customization-service, чтобы Spotify
#      возвращал полноценный HTTP 200 body вместо потенциального 304.
#   2. Для Artist View меняет platform=iphone на platform=ipad.
#   3. Локально отвечает HTTP 200 на рекламные endpoint ad-* и pendragon.
#   4. Обрабатывает bootstrap и user-customization-service локальным JS.
#
# ВАЖНО:
#   • отдельное правило блокировки QUIC здесь намеренно отсутствует;
#   • прежнее PROTOCOL,QUIC удалено как некорректное для Shadowrocket;
#   • глобально блокировать UDP/443 внутри Spotify-модуля не требуется и
#     нежелательно, поскольку это могло бы затронуть посторонний трафик.
#
# Ограничения:
#   • это не серверная подписка Spotify Premium;
#   • серверные функции Spotify могут оставаться недоступными;
#   • максимальное качество Very High не гарантируется;
#   • совместимость зависит от текущей версии Spotify и структуры его API.
#
# MITM ограничен Spotify API-хостами ниже. Сертификат Shadowrocket должен быть
# установлен и считаться доверенным в iOS.


# =============================================================================
# HEADER REWRITE: ЗАЩИТА ОТ HTTP 304
# =============================================================================
#
# Источник подхода: app2smile/rules.
#
# Spotify может отправлять If-None-Match для user-customization-service.
# Сервер тогда способен вернуть 304 Not Modified без нового тела ответа, а
# response-скрипту нечего будет модифицировать. Удаляем только этот заголовок
# и только для нужного Spotify endpoint.
#
# Никакие другие заголовки, cookies или Authorization здесь не изменяются.

[Header Rewrite]
http-request ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/user-customization-service\/v1\/customize$ header-del if-none-match


# =============================================================================
# URL REWRITE: ARTIST VIEW
# =============================================================================
#
# Подход используется в сборках 001ProMax/LOWERTOP.
# Для Artist View platform=iphone заменяется на platform=ipad.

[URL Rewrite]
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad header


# =============================================================================
# MAP LOCAL: РЕКЛАМНЫЕ ENDPOINT
# =============================================================================
#
# Для endpoint ad-* и pendragon Shadowrocket возвращает локальный пустой
# HTTP 200 вместо передачи запроса дальше.

[Map Local]
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:ad-|pendragon) data-type=text data="" status-code=200


# =============================================================================
# SCRIPT: ЛОКАЛЬНАЯ ОБРАБОТКА SPOTIFY
# =============================================================================
#
# Файл находится в этом же репозитории:
#   modules/spotify.response.js
#
# Скрипт не выполняет внешних HTTP-запросов. Он локально разбирает бинарный
# protobuf-ответ Spotify, изменяет клиентские account attributes и собирает
# protobuf обратно. Неизвестные protobuf-поля сохраняются.
#
# Компактная_панель передаётся как argument=tab=... .
#
# В целях защиты от незаметной подмены script-path привязан к commit:
#   68921b076e22c2747c87f7c744aadb0b1a5090b2
# Этот Git commit неизменяем; будущие изменения ветки main не подменят JS.

[Script]
Spotify.Response = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/68921b076e22c2747c87f7c744aadb0b1a5090b2/modules/spotify.response.js,requires-body=true,binary-body-mode=true,max-size=0,argument=tab={{{Компактная_панель}}}


# =============================================================================
# MITM
# =============================================================================
#
# %APPEND% добавляет только нужные Spotify API-хосты к существующему MITM.
# Другие домены устройства этим модулем не добавляются в MITM.

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com
