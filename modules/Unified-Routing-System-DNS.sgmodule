#!name=Unified Routing + System DNS
#!desc=Единый модуль: DIRECT/PROXY/REJECT + выборочный System DNS. Использовать вместе с remote.conf.
#!author=OpenAI + user
#!version=1.1

# =============================================================================
# ПАМЯТКА / НАЗНАЧЕНИЕ
# =============================================================================
# Это единый прикладной модуль Shadowrocket для всей сервисной маршрутизации.
# Используется ВМЕСТЕ с основным config/remote.conf.
#
# remote.conf отвечает за глобальные [General], DNS по умолчанию, TUN/сетевые
# параметры, GEOIP,RU,DIRECT и FINAL,PROXY.
# Этот модуль НЕ содержит [General] и не меняет глобальный DNS для всего трафика.
#
# =============================================================================
# ЧТО ВХОДИТ В МОДУЛЬ
# =============================================================================
# Маршрутизация и блокировки:
#   - DIRECT
#   - PROXY
#   - REJECT
#   - REJECT-ARRAY
#   - REJECT-TINYGIF
#   - REJECT-DICT
#   - REJECT-200
#
# Типы правил:
#   - DOMAIN / DOMAIN-SUFFIX / DOMAIN-KEYWORD
#   - IP-CIDR / IP-CIDR6 с no-resolve там, где это требуется
#   - PROCESS-NAME / USER-AGENT
#   - AND-правила, включая UDP/VoIP
#
# Сервисы и группы правил:
#   - Telegram: домены + официальные IPv4/IPv6 CIDR
#   - WhatsApp: домены + IPv4/IPv6 + UDP/VoIP
#   - Meta / Facebook / Messenger / Instagram
#   - TikTok: жёсткий PROXY + встроенный snapshot внешних rule-set
#   - VK / Mail / OK / MY: DIRECT + privacy/ad/tracker REJECT-правила
#   - Apple: DIRECT + выборочный System DNS
#   - BiP
#   - JumpDesktop
#   - WHOOSH
#   - Manual DIRECT
#   - Manual PROXY
#   - RU TLD: .ru / .su / .рф
#   - российские сервисы на иностранных TLD (.com/.net/.tv/.aero/.one/.st и др.)
#
# =============================================================================
# DNS-ЛОГИКА
# =============================================================================
# [Host] содержит единый список доменов, которым ЯВНО назначен:
#     server:system
#
# Только домены, перечисленные в [Host], принудительно резолвятся через System DNS.
# Остальные домены продолжают использовать глобальную DNS-схему из remote.conf.
#
# Важно: правило DIRECT в [Rule] само по себе НЕ означает System DNS.
# System DNS применяется только при наличии соответствующей записи в [Host].
# Поэтому dns-direct-system=false в remote.conf должен оставаться глобальной базой,
# если архитектура не меняется сознательно.
#
# Основная цель selective System DNS:
#   - повысить отказоустойчивость при деградации/блокировках зарубежных DNS в РФ;
#   - .ru/.su/.рф и выбранные российские сервисы резолвить через локальный System DNS;
#   - Apple и другие явно выбранные инфраструктурные домены также резолвить System DNS;
#   - весь остальной интернет оставить на DNS-политике remote.conf.
#
# =============================================================================
# ВАЖНЫЕ ПРАВИЛА ЭКСПЛУАТАЦИИ
# =============================================================================
# 1. Shadowrocket использует first-match: порядок [Rule] имеет значение.
# 2. Не включать одновременно этот Unified-модуль и старые исходные routing-модули,
#    из которых он собран. Это создаст дубли/перекрытия и может изменить first-match.
# 3. Отдельный старый RU-TLD-RU-Non-RU-DIRECT-System-DNS.sgmodule также не нужен,
#    если включён этот Unified-модуль: его политика уже интегрирована сюда.
# 4. Старый Routing.sgmodule не должен работать параллельно с этим модулем после
#    перехода на Unified: этот файл предназначен быть его полной заменой.
# 5. YouTube Rewrite/Script/MITM функциональность в этот файл НЕ входит и остаётся
#    отдельным Youtube-Config.sgmodule. Здесь есть только routing-правила, если они
#    были частью исходных routing-модулей.
# 6. TikTok внешние RULE-SET встроены в файл snapshot-ом для автономности. При
#    будущей актуализации TikTok список нужно сверять с upstream отдельно.
# 7. Общие CDN-маски Apple (например глобальные *.akamaized.net / *.fastly.net)
#    намеренно не используются как широкие System DNS/DIRECT правила, чтобы не
#    перехватывать чужие сервисы вроде TikTok и других пользователей общих CDN.
#
# =============================================================================
# ПРОИСХОЖДЕНИЕ
# =============================================================================
# Собрано из 11 пользовательских routing-модулей + политики
# RU TLD / RU Non-RU DIRECT + System DNS.
# Пользовательские selector-группы исходников нормализованы к встроенному PROXY,
# чтобы итоговый модуль не требовал дополнительных proxy-group от получателя.
#
[Rule]

# ==================================================
# REJECT-ARRAY RULES
# ==================================================

# --- VK Direct Stable Privacy DNS Test ---
DOMAIN,alt-ad.mail.ru,REJECT-ARRAY
DOMAIN,ad.mail.ru,REJECT-ARRAY

# ==================================================
# REJECT-TINYGIF RULES
# ==================================================

# --- VK Direct Stable Privacy DNS Test ---
DOMAIN-SUFFIX,mradx.net,REJECT-TINYGIF

# ==================================================
# REJECT-DICT RULES
# ==================================================

# --- VK Direct Stable Privacy DNS Test ---
DOMAIN-SUFFIX,target.my.com,REJECT-DICT
DOMAIN-SUFFIX,advertising.my.com,REJECT-DICT
DOMAIN-SUFFIX,mytarget.com,REJECT-DICT

# ==================================================
# REJECT RULES
# ==================================================

# --- VK Direct Stable Privacy DNS Test ---
DOMAIN-SUFFIX,tracker-api.vk-analytics.ru,REJECT
DOMAIN-SUFFIX,vk-analytics.ru,REJECT
DOMAIN-SUFFIX,tracker-api.my.com,REJECT

# ==================================================
# REJECT-200 RULES
# ==================================================

# --- VK Direct Stable Privacy DNS Test ---
DOMAIN-SUFFIX,top.mail.ru,REJECT-200
DOMAIN,r.mail.ru,REJECT-200

# ==================================================
# PROXY RULES
# ==================================================

