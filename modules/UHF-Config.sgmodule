#!name=UHF – Sync Diagnostic
#!desc=Пассивная диагностика UHF Backup sync: URL/status и только безопасные совпадения sync/backup/cloud/feature. Ничего не подменяет.

# last_update=2026-09-27_UTC
# Status: TEST / diagnostic
# Repository: Alexgood321 / SR-ALL-FILES-PROXY
#
# Уже установлено:
#   • UHF использует Firebase App Check/Auth + Firestore;
#   • Firestore нельзя MITM'ить этим способом: TLS verify failure до HTTP;
#   • Firebase auth-token не содержит признаков права на Backup sync;
#   • при открытии Backup and devices наблюдался Apple iCloud content endpoint,
#     поэтому iCloud-контур оставляем нетронутым и проверяем по обычному PacketTunnel.
#
# Этот модуль НЕ пишет токены, raw body или HEX.
# Скрипт выводит только URL/status и строки с признаками:
# sync / backup / cloud / icloud / feature / active / enabled / device / playlist.
#
# Firestore, StoreKit и системные iCloud endpoints не MITM'ятся.
#
# Safe diagnostic script pinned at immutable commit:
# 62a1f68e03ddc009a4db48fa5da8809e9be98b97

[Script]
uhf-sync-request = type=http-request,pattern=^https:\/\/(firebaseappcheck\.googleapis\.com|securetoken\.googleapis\.com|identitytoolkit\.googleapis\.com|firebaseinstallations\.googleapis\.com|firebaselogging-pa\.googleapis\.com|app-measurement\.com)\/.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/62a1f68e03ddc009a4db48fa5da8809e9be98b97/modules/uhf/uhf-sync-safe.js,script-update-interval=0

uhf-sync-response = type=http-response,pattern=^https:\/\/(firebaseappcheck\.googleapis\.com|securetoken\.googleapis\.com|identitytoolkit\.googleapis\.com|firebaseinstallations\.googleapis\.com|firebaselogging-pa\.googleapis\.com|app-measurement\.com)\/.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/62a1f68e03ddc009a4db48fa5da8809e9be98b97/modules/uhf/uhf-sync-safe.js,script-update-interval=0

[MITM]
hostname = %APPEND% firebaseappcheck.googleapis.com, securetoken.googleapis.com, identitytoolkit.googleapis.com, firebaseinstallations.googleapis.com, firebaselogging-pa.googleapis.com, app-measurement.com
