#!name=UHF – Sync Diagnostic
#!desc=Однопроходная пассивная диагностика UHF: Firebase Auth/App Check/Installations + Analytics, поиск сигналов sync/cloud/feature state. Ничего не подменяет.

# last_update=2026-09-27_UTC
# Status: TEST / diagnostic
# Repository: Alexgood321 / SR-ALL-FILES-PROXY
#
# Цель: за один чистый запуск UHF собрать максимум данных о механике
# multi-device sync и связанных backend/API запросах.
#
# Уже установлено по PacketTunnel:
#   • UHF использует Firestore;
#   • MITM firestore.googleapis.com на iOS обрывается до HTTP с
#     "A verify action has failed", поэтому Firestore исключён из MITM;
#   • на чистом запуске наблюдались Firebase App Check, Secure Token,
#     Firestore, Google Analytics и системные Apple StoreKit endpoints;
#   • gateway.icloud.com присутствовал в системном трафике, но принадлежность
#     именно UHF не доказана, поэтому системный iCloud endpoint не MITM'им.
#
# Перехватываем:
#   • Firebase App Check
#   • Firebase Secure Token/Auth
#   • Identity Toolkit, если появится
#   • Firebase Installations, если появится
#   • Firebase/Google Analytics
#
# Диагностический JS пишет:
#   • URL + HTTP method
#   • response status
#   • request/response headers
#   • text/JSON body
#   • binary/protobuf: HEX + ASCII + printable strings
#   • отдельные INTEREST-строки для sync/cloud/icloud/feature/active/enabled
#   • credential/token значения маскируются
#
# Не MITM'им:
#   • firestore.googleapis.com — подтверждён TLS verify failure
#   • Apple StoreKit endpoints — системный контур, их наличие видно в обычном логе
#   • gateway.icloud.com — общий системный iCloud endpoint
#
# Diagnostic script pinned at immutable commit:
# 90cfb98109a0ba1d34acbf4d26aa626cddaafd47

[Script]
uhf-sync-request = type=http-request,pattern=^https:\/\/(firebaseappcheck\.googleapis\.com|securetoken\.googleapis\.com|identitytoolkit\.googleapis\.com|firebaseinstallations\.googleapis\.com|firebaselogging-pa\.googleapis\.com|app-measurement\.com)\/.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/90cfb98109a0ba1d34acbf4d26aa626cddaafd47/modules/uhf/uhf-sync-diagnostic.js,script-update-interval=0

uhf-sync-response = type=http-response,pattern=^https:\/\/(firebaseappcheck\.googleapis\.com|securetoken\.googleapis\.com|identitytoolkit\.googleapis\.com|firebaseinstallations\.googleapis\.com|firebaselogging-pa\.googleapis\.com|app-measurement\.com)\/.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/90cfb98109a0ba1d34acbf4d26aa626cddaafd47/modules/uhf/uhf-sync-diagnostic.js,script-update-interval=0

[MITM]
hostname = %APPEND% firebaseappcheck.googleapis.com, securetoken.googleapis.com, identitytoolkit.googleapis.com, firebaseinstallations.googleapis.com, firebaselogging-pa.googleapis.com, app-measurement.com
