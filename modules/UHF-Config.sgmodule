#!name=UHF – MITM Full Diagnostic
#!desc=Однопроходная диагностика UHF IPTV Player: URL, method/status, headers, text/JSON и binary body для Firebase App Check/Auth/Firestore. Ничего не изменяет.

# last_update=2026-09-27_UTC
# Status: TEST / diagnostic
# Repository: Alexgood321 / SR-ALL-FILES-PROXY
#
# Цель: за один PacketTunnel-прогон получить максимум данных, необходимых для
# понимания архитектуры UHF и дальнейшего MITM-модуля, без последовательного
# добавления отдельных endpoint'ов вручную.
#
# Подтверждено runtime-логом UHF от 2026-09-27:
#   • firebaseappcheck.googleapis.com — Firebase App Check
#   • securetoken.googleapis.com — Firebase Auth / token refresh
#   • firestore.googleapis.com — Firestore backend; наблюдалось длинное соединение,
#     поэтому диагностический JS умеет логировать как текст, так и binary/protobuf.
#
# Что пишет диагностический JS:
#   • request URL + HTTP method
#   • response status
#   • request/response headers
#   • request/response body
#   • JSON/text — читаемым текстом
#   • binary/protobuf/gRPC — размер + HEX + ASCII preview
#   • длинные значения дробятся на несколько строк, чтобы лог не терял их целиком
#
# Чувствительные credential/token значения маскируются. Для Bearer JWT логируются
# только доступные claims, а не сам токен. Остальные данные запросов/ответов не меняются.
#
# Намеренно НЕ MITM'им:
#   • mzstorekit.itunes.apple.com
#   • inappcheck.itunes.apple.com
# Apple StoreKit уже виден в обычном PacketTunnel-логе. Его MITM может сам нарушить
# purchase/receipt validation и создать ложный результат, поэтому для первого полного
# диагностического прохода он остаётся нетронутым.
#
# Также не перехватываем Crashlytics/telemetry: они дают шум, а не entitlement state.
#
# Diagnostic script pinned at immutable commit:
# c43efedf1f9ea687427208319259d5cf8b951f11

[Script]
# REQUEST: максимально полный пассивный снимок URL/headers/body.
uhf-diagnostic-request = type=http-request,pattern=^https:\/\/(firestore\.googleapis\.com|firebaseappcheck\.googleapis\.com|securetoken\.googleapis\.com)\/.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/c43efedf1f9ea687427208319259d5cf8b951f11/modules/uhf/uhf-diagnostic.js,script-update-interval=0

# RESPONSE: status/headers/body; binary-body-mode нужен для protobuf/gRPC.
uhf-diagnostic-response = type=http-response,pattern=^https:\/\/(firestore\.googleapis\.com|firebaseappcheck\.googleapis\.com|securetoken\.googleapis\.com)\/.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Alexgood321/SR-ALL-FILES-PROXY/c43efedf1f9ea687427208319259d5cf8b951f11/modules/uhf/uhf-diagnostic.js,script-update-interval=0

[MITM]
hostname = %APPEND% firestore.googleapis.com, firebaseappcheck.googleapis.com, securetoken.googleapis.com
