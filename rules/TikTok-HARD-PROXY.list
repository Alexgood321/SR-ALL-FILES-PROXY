# last_update=2026-08-30_18:31:54_UTC
# Модуль: TikTok – HARD PROXY
# Политика PROXY задаётся в config/remote.conf.

# -------------------------------------------------
# 1) RULE-SET (2 источника) — как бонус (если загрузились, расширят покрытие)
# Внешний источник подключён отдельно в remote.conf: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/TikTok/TikTok.list
# Внешний источник подключён отдельно в remote.conf: https://raw.githubusercontent.com/Semporia/TikTok-Unlock/master/Surge/TikTok.list
# -------------------------------------------------

# -------------------------------------------------
# 2) ВСТРОЕННЫЙ fallback (работает даже если rule-set не загрузился)
# Core / API / App
DOMAIN-SUFFIX,tiktok.com
DOMAIN-SUFFIX,tik-tokapi.com
DOMAIN-SUFFIX,tiktokv.com
DOMAIN-SUFFIX,tiktokv.us
DOMAIN-SUFFIX,ttwebview.com
DOMAIN-SUFFIX,tiktokmusic.app

# CDN / Assets
DOMAIN-SUFFIX,tiktokcdn.com
DOMAIN-SUFFIX,tiktokcdn-us.com
DOMAIN,p16-tiktokcdn-com.akamaized.net
DOMAIN-SUFFIX,ttlivecdn.com
DOMAIN-SUFFIX,tiktokrow-cdn.com

# ByteDance infra / telemetry / sdk
DOMAIN-SUFFIX,snssdk.com
DOMAIN-SUFFIX,isnssdk.com
DOMAIN-SUFFIX,ibyteimg.com
DOMAIN-SUFFIX,ibytedtos.com
DOMAIN-SUFFIX,byteoversea.com
DOMAIN-SUFFIX,ipstatp.com
DOMAIN-SUFFIX,sgpstatp.com
DOMAIN-SUFFIX,bytedapm.com
DOMAIN-SUFFIX,byteintlapi.com
DOMAIN-SUFFIX,bytegecko-i18n.com

# Extra ecosystem (часто всплывает рядом)
DOMAIN-SUFFIX,capcut.com

# Legacy/media
DOMAIN-SUFFIX,musical.ly
DOMAIN-SUFFIX,muscdn.com
DOMAIN-SUFFIX,tiktokd.net
DOMAIN-SUFFIX,tiktokd.org

# (встречается у части пользователей/регионов; держим как узкий DOMAIN)
DOMAIN,lf16-effectcdn.byteeffecttos-g.com
DOMAIN,lf16-pkgcdn.pitaya-clientai.com
# -------------------------------------------------

# -------------------------------------------------
# 3) Keyword-ловушки (на случай новых поддоменов/вариаций)
DOMAIN-KEYWORD,tiktok
DOMAIN-KEYWORD,-tiktokcdn-com
DOMAIN-KEYWORD,musical.ly
# -------------------------------------------------

# -------------------------------------------------
# 4) UA-страховка
USER-AGENT,TikTok*
# -------------------------------------------------

# -------------------------------------------------
# 5) Слот под новые находки из логов
# DOMAIN-SUFFIX,example.com,TikTok-Proxy
# IP-CIDR,A.B.C.D/32,TikTok-Proxy,no-resolve
# -------------------------------------------------
