# Модуль: Telegram -> PROXY (Full)
# Весь Telegram (домены + медиа + официальные CIDR) через прокси. Подходит для видео/медиа/звонков/ботов и обхода замедлений.
# Политика PROXY задаётся в config/remote.conf.

# --- Telegram домены (основные) ---
DOMAIN-SUFFIX,telegram.org
DOMAIN-SUFFIX,t.me
DOMAIN-SUFFIX,telegram.me
DOMAIN-SUFFIX,telegram.dog
DOMAIN-SUFFIX,telegra.ph
DOMAIN-SUFFIX,telesco.pe
DOMAIN-SUFFIX,tdesktop.com
DOMAIN-SUFFIX,graph.org
DOMAIN-SUFFIX,tx.me

# --- Медиа/файлы / CDN ---
DOMAIN-SUFFIX,telegramusercontent.com
DOMAIN-SUFFIX,cdn-telegram.org

# --- Доп. домены (редко, но полезно) ---
DOMAIN-SUFFIX,comments.app
DOMAIN-SUFFIX,telegramdownload.com
DOMAIN-SUFFIX,stel.com
DOMAIN-SUFFIX,telega.one
DOMAIN-SUFFIX,telegram.space

# --- API/кабинет ---
DOMAIN,api.telegram.org
DOMAIN,my.telegram.org

